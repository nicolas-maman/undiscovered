{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nicolas-maman/undiscovered/schemas/unit.schema.json",
  "title": "Work unit",
  "type": "object",
  "required": [
    "unit",
    "protocol",
    "kind",
    "quorum"
  ],
  "properties": {
    "unit": {
      "type": "string",
      "pattern": "^u-[0-9]{6}$"
    },
    "protocol": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "map",
        "distill",
        "rank",
        "judge"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]+$"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "freeze": {
      "type": "integer",
      "minimum": 2000
    },
    "works": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^W[0-9]+$"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "avoid": {
      "type": "object",
      "description": "distill: for each work, its distinctive words, which a description may reuse at most max_avoided of",
      "propertyNames": {
        "pattern": "^W[0-9]+$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 20
      }
    },
    "max_avoided": {
      "type": "integer",
      "minimum": 0
    },
    "topic": {
      "type": "string",
      "pattern": "^T[0-9]+$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]+$"
      },
      "maxItems": 50
    },
    "bridge": {
      "type": "string",
      "pattern": "^b-T[0-9]+-T[0-9]+$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^W[0-9]+$"
      },
      "maxItems": 2
    },
    "as_of": {
      "type": "integer"
    },
    "instructions": {
      "type": "string"
    },
    "quorum": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "open",
        "check",
        "done",
        "disputed"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "distill units: the models that have described the unit, as \"<id> (<provider>)\"; set by the checking job"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "author",
          "model"
        ],
        "properties": {
          "issue": {
            "type": "integer"
          },
          "author": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "relevance": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "description": "distill units: each accepted result, by issue, with the share of its descriptions that found their own paper's abstract; set by the checking job"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "map"
          }
        }
      },
      "then": {
        "required": [
          "topics",
          "freeze"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "distill"
          }
        }
      },
      "then": {
        "required": [
          "works"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rank"
          }
        }
      },
      "then": {
        "required": [
          "topic",
          "candidates"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "judge"
          }
        }
      },
      "then": {
        "required": [
          "bridge",
          "evidence"
        ]
      }
    }
  ]
}
