const SPACE_COUNT = 10
const SPACE_RANGES: int[20] = [
    0x00009, 0x0000D, 0x0001C, 0x00020, 0x00085, 0x00085, 0x000A0, 0x000A0,
    0x01680, 0x01680, 0x02000, 0x0200A, 0x02028, 0x02029, 0x0202F, 0x0202F,
    0x0205F, 0x0205F, 0x03000, 0x03000
]
const TAG_COUNT = 13
// letter, code point
const TAG_LETTERS: int[26] = [
    0x00074, 0x00054, 0x00074, 0x00074, 0x00068, 0x00048, 0x00068, 0x00068,
    0x00069, 0x00049, 0x00069, 0x00069, 0x00069, 0x00130, 0x00069, 0x00131,
    0x0006E, 0x0004E, 0x0006E, 0x0006E, 0x0006B, 0x0004B, 0x0006B, 0x0006B,
    0x0006B, 0x0212A
]

// What str.lower() makes of `cp`, for any code point but U+0130 and U+03A3.
lower_code(cp: int) -> int {
    if cp < 128 {
        if cp >= 65 && cp <= 90 {
            return cp + 32
        }
        return cp
    }
    lo = 0
    hi = RUN_COUNT
    while lo < hi {
        mid = (lo + hi) / 2
        if cp < LOWER_RUNS[4 * mid] {
            hi = mid
        } else if cp > LOWER_RUNS[4 * mid + 1] {
            lo = mid + 1
        } else {
            if (cp - LOWER_RUNS[4 * mid]) % LOWER_RUNS[4 * mid + 2] == 0 {
                return cp + LOWER_RUNS[4 * mid + 3]
            }
            return cp
        }
    }
    return cp
}

// 1 when `cp` is cased and not case-ignorable, as the final-sigma rule reads it.
is_cased(cp: int) -> int {
    lo = 0
    hi = CASED_COUNT
    while lo < hi {
        mid = (lo + hi) / 2
        if cp < CASED_RANGES[2 * mid] {
            hi = mid
        } else if cp > CASED_RANGES[2 * mid + 1] {
            lo = mid + 1
        } else {
            return 1
        }
    }
    return 0
}

// 1 when `cp` is case-ignorable, which the final-sigma rule skips.
is_case_ignorable(cp: int) -> int {
    lo = 0
    hi = IGNORABLE_COUNT
    while lo < hi {
        mid = (lo + hi) / 2
        if cp < IGNORABLE_RANGES[2 * mid] {
            hi = mid
        } else if cp > IGNORABLE_RANGES[2 * mid + 1] {
            lo = mid + 1
        } else {
            return 1
        }
    }
    return 0
}

// 1 when str.isspace() says `cp` is space.
is_space(cp: int) -> int {
    lo = 0
    hi = SPACE_COUNT
    while lo < hi {
        mid = (lo + hi) / 2
        if cp < SPACE_RANGES[2 * mid] {
            hi = mid
        } else if cp > SPACE_RANGES[2 * mid + 1] {
            lo = mid + 1
        } else {
            return 1
        }
    }
    return 0
}

// 1 when re.IGNORECASE matches `cp` with `letter`, one of t h i n k.
tag_letter(cp: int, letter: int) -> int {
    i = 0
    while i < TAG_COUNT {
        if TAG_LETTERS[2 * i] == letter && TAG_LETTERS[2 * i + 1] == cp {
            return 1
        }
        i = i + 1
    }
    return 0
}
