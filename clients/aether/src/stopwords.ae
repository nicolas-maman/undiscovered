// 1 when `key` is the key of a stop word, else 0.
is_stop_key(key: long) -> int {
    lo = 0
    hi = COUNT
    while lo < hi {
        mid = (lo + hi) / 2
        if KEYS[mid] == key {
            return 1
        }
        if KEYS[mid] < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}
