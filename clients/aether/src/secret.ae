// Read a line without showing it, as Python's getpass does: console echo off
// on Windows, `stty -echo` elsewhere. When input is not a terminal it is read
// as it comes.

import std.string
import std.io
import std.os

exports(read)

when target.os == "windows" {
    extern GetStdHandle(which: int) -> ptr @c_import
    extern GetConsoleMode(handle: ptr, mode: ptr) -> int @c_import
    extern SetConsoleMode(handle: ptr, mode: int) -> int @c_import

    const STD_INPUT_HANDLE = -10
    const ENABLE_ECHO_INPUT = 4

    extern malloc(size: int) -> ptr
    extern free(p: ptr)

    // The line typed after `prompt`, trimmed, with the typing not shown.
    read(prompt: string) -> string {
        print(prompt)
        handle = GetStdHandle(STD_INPUT_HANDLE)
        word = malloc(4)            // the DWORD GetConsoleMode fills
        hidden = GetConsoleMode(handle, word)
        mode = (word as int[])[0]
        free(word)
        if hidden != 0 {
            SetConsoleMode(handle, mode & ~ENABLE_ECHO_INPUT)
        }
        line, _err = io.fd_read_line(0)
        if hidden != 0 {
            SetConsoleMode(handle, mode)
            println("")
        }
        return string.trim(line)
    }
} else {
    // The line typed after `prompt`, trimmed, with the typing not shown.
    read(prompt: string) -> string {
        print(prompt)
        hidden = os.os_system("stty -echo 2>/dev/null")
        line, _err = io.fd_read_line(0)
        if hidden == 0 {
            os.os_system("stty echo 2>/dev/null")
            println("")
        }
        return string.trim(line)
    }
}
