// Is an abstract usable: an English text long enough to say what the paper
// is about. The same rule as the Python client (mapper.py usable()): at
// least 40 words, and at least a quarter of them stop words, where the words
// are what Python's re.findall(r"[^\W\d_]+", text.lower()) finds.

import std.string
import letters
import stopwords

exports(count_words, is_usable, MIN_WORDS)

const MIN_WORDS = 40

// The number of words in `text`, and how many of them are stop words.
//
// A word is a run of letters (a letter, or a number that is not a decimal
// digit, in Unicode's sense), read after lowercasing. Lowering never turns a
// letter into a non-letter or back, except for two code points the generated
// table names: U+0130 lowers to "i" plus a combining dot, so it ends its
// word, and U+212A (Kelvin sign) lowers to an ASCII "k". A stop word is all
// ASCII, so a word holding any other non-ASCII letter is never one.
count_words(text: string) -> (int, int) {
    b = string.bytes(text)
    n = b.len
    words = 0
    stops = 0
    in_word = 0
    plain = 1       // the word so far is all ASCII letters once lowered
    wlen = 0
    long key = 0
    i = 0
    while i < n {
        c = b[i] as int
        cp = c
        step = 1
        if c >= 0xF0 && i + 3 < n {
            cp = ((c & 7) << 18) | ((b[i + 1] as int & 63) << 12) | ((b[i + 2] as int & 63) << 6) | (b[i + 3] as int & 63)
            step = 4
        } else if c >= 0xE0 && i + 2 < n {
            cp = ((c & 15) << 12) | ((b[i + 1] as int & 63) << 6) | (b[i + 2] as int & 63)
            step = 3
        } else if c >= 0xC0 && i + 1 < n {
            cp = ((c & 31) << 6) | (b[i + 1] as int & 63)
            step = 2
        } else if c >= 0x80 {
            cp = -1     // a byte out of place (the JSON parser lets none through)
        }

        letter = 0
        ascii = 0       // the lowered letter when it is ASCII
        ends = 0        // the word ends right after this letter
        if cp >= 65 && cp <= 90 {
            letter = 1
            ascii = cp + 32
        } else if cp >= 97 && cp <= 122 {
            letter = 1
            ascii = cp
        } else if cp == letters.KELVIN_SIGN {
            letter = 1
            ascii = 107
        } else if cp == letters.DOTTED_CAPITAL_I {
            letter = 1
            ascii = 105
            ends = 1
        } else if cp >= 128 {
            letter = letters.is_letter(cp)
        }

        if letter == 1 {
            if in_word == 0 {
                in_word = 1
                plain = 1
                wlen = 0
                key = 0
            }
            wlen = wlen + 1
            if ascii == 0 {
                plain = 0
            } else if wlen <= stopwords.LONGEST {
                key = key * 27 + (ascii - 96)
            }
        }
        if in_word == 1 && (letter == 0 || ends == 1) {
            words = words + 1
            if plain == 1 && wlen <= stopwords.LONGEST && stopwords.is_stop_key(key) == 1 {
                stops = stops + 1
            }
            in_word = 0
        }
        i = i + step
    }
    if in_word == 1 {
        words = words + 1
        if plain == 1 && wlen <= stopwords.LONGEST && stopwords.is_stop_key(key) == 1 {
            stops = stops + 1
        }
    }
    return words, stops
}

// 1 when a text of `words` words, `stops` of them stop words, is usable.
// stops / words >= 0.25 exactly when 4 * stops >= words.
is_usable(words: int, stops: int) -> int {
    if words < MIN_WORDS {
        return 0
    }
    if 4 * stops >= words {
        return 1
    }
    return 0
}
