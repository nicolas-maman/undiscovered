// Submitting results through the volunteer's own GitHub account, as the
// Python client's github.py. The token comes from GITHUB_TOKEN or from the
// GitHub command-line tool (`gh auth login` once). It is sent only to
// GitHub and never printed.

import std.string
import std.strbuilder
import std.os
import std.list
import std.json
import std.http.client
import settings
import jsontext
import openalex

exports(token, gist_body, issue_body, create_gist, open_issue, API, NO_LOGIN)

extern free(p: ptr)

const API = "https://api.github.com"
const NO_LOGIN = "No GitHub login found. Install the GitHub command-line tool (https://cli.github.com) and run: gh auth login"

which(name: string) -> string {
    raw = os.os_which(name)
    if raw == null {
        return string.copy("")
    }
    found = string.copy(raw)
    free(raw)
    return found
}

// The volunteer's GitHub token, or ("", NO_LOGIN) when there is none.
token() -> (string, string) {
    tok = settings.env("GITHUB_TOKEN")
    if string.length(tok) > 0 {
        return tok, ""
    }
    gh = which("gh")
    if string.length(gh) > 0 {
        args = list.new()
        list.add(args, "auth")
        list.add(args, "token")
        out, status, err = os.run_capture(gh, args, null)
        list.free(args)
        if err == "" && status == 0 {
            found = string.trim(out)
            if string.length(found) > 0 {
                return found, ""
            }
        }
    }
    return string.copy(""), NO_LOGIN
}

// The request body that creates a secret gist holding one file, as Python's
// requests writes it (json.dumps with its default separators).
gist_body(filename: string, content: string, description: string) -> string {
    sb = strbuilder.new(string.length(content) + 256)
    strbuilder.append(sb, "{\"description\": ")
    jsontext.quote_into(sb, description)
    strbuilder.append(sb, ", \"public\": false, \"files\": {")
    jsontext.quote_into(sb, filename)
    strbuilder.append(sb, ": {\"content\": ")
    jsontext.quote_into(sb, content)
    strbuilder.append(sb, "}}}")
    return strbuilder.finish(sb)
}

// The request body that opens an issue with no labels.
issue_body(title: string, body: string) -> string {
    sb = strbuilder.new(string.length(body) + 128)
    strbuilder.append(sb, "{\"title\": ")
    jsontext.quote_into(sb, title)
    strbuilder.append(sb, ", \"body\": ")
    jsontext.quote_into(sb, body)
    strbuilder.append(sb, ", \"labels\": []}")
    return strbuilder.finish(sb)
}

// POST `body` to the GitHub API and return the html_url of what it made.
post(tok: string, path: string, body: string) -> (string, string) {
    url = "${API}/${path}"
    req = client.request("POST", url)
    client.set_header(req, "Authorization", "Bearer ${tok}")
    client.set_header(req, "Accept", "application/vnd.github+json")
    client.set_header(req, "X-GitHub-Api-Version", "2022-11-28")
    client.set_header(req, "User-Agent", openalex.user_agent())
    client.set_body(req, string.bytes(body), "application/json")
    client.set_timeout(req, 60s)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        return string.copy(""), "GitHub could not be reached (${err}) for ${url}"
    }
    status = client.response_status(resp)
    answer = client.response_body(resp)
    client.response_free(resp)
    doc, perr = json.parse(answer)
    if status < 200 || status > 299 {
        why = ""
        if perr == "" {
            why = jsontext.text(doc, "message")
            json.json_free(doc)
        }
        if string.length(why) > 0 {
            return string.copy(""), "GitHub answered ${status} (${why}) for ${url}"
        }
        return string.copy(""), "GitHub answered ${status} for ${url}"
    }
    if perr != "" {
        return string.copy(""), "GitHub sent an answer that is not JSON for ${url}"
    }
    link = jsontext.text(doc, "html_url")
    json.json_free(doc)
    return link, ""
}

// A secret gist: not listed anywhere, readable by anyone with its address.
create_gist(tok: string, filename: string, content: string, description: string) -> (string, string) {
    return post(tok, "gists", gist_body(filename, content, description))
}

// An issue on `repo`; returns its address.
open_issue(tok: string, repo: string, title: string, body: string) -> (string, string) {
    return post(tok, "repos/${repo}/issues", issue_body(title, body))
}
