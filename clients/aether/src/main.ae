// The `undiscovered` command, the Aether client. Same commands, options,
// messages and results as the Python client (clients/python):
//
//     undiscovered setup          answer three questions once
//     undiscovered work           take an open unit, do it, submit it
//     undiscovered work --units 5 do five, one after another
//     undiscovered work --dry-run do one and save it here instead of submitting
//     undiscovered work --unit u-000241 --dry-run   a given unit, for example to compare clients
//     undiscovered work --kind map                  map units even when a model is set up
//     undiscovered --version
//
// With a model set up, `work` takes describing (distill) units, the job
// that needs one; without one, map units.

import std.string
import std.os
import std.io
import version
import work

// Ctrl-C stops the client as it stops the Python one.
extern signal(sig: int, handler: fn(int)) -> ptr
extern _exit(code: int) @c_import

const SIGINT = 2

// Nothing is submitted before a unit is complete, so stopping is always clean.
@c_callback
on_interrupt(sig: int) {
    io.stderr_write("Stopped. Nothing half-done was submitted.\n")
    _exit(1)
}

const USAGE = "usage: undiscovered [-h] [--version] {setup,work} ...\n"
const WORK_USAGE = "usage: undiscovered work [-h] [--units UNITS] [--dry-run] [--unit UNIT]\n                         [--kind {auto,map,distill}]\n"
const SETUP_USAGE = "usage: undiscovered setup [-h]\n"

const HELP = "\nLend your computer to undiscovered.\n\npositional arguments:\n  {setup,work}\n    setup       answer three questions once\n    work        take an open unit, do it, submit it\n\noptions:\n  -h, --help    show this help message and exit\n  --version     show program's version number and exit\n"
const WORK_HELP = "\noptions:\n  -h, --help            show this help message and exit\n  --units UNITS         how many units to do (default 1)\n  --dry-run             save the result here instead of submitting\n  --unit UNIT           do this unit rather than a random open one\n  --kind {auto,map,distill}\n                        map units, describing (distill) units, or auto:\n                        distill when a model is set up\n"
const SETUP_HELP = "\noptions:\n  -h, --help  show this help message and exit\n"

// A usage error, as argparse reports it: usage and reason on stderr, code 2.
usage_error(usage: string, prog: string, reason: string) {
    io.stderr_write("${usage}${prog}: error: ${reason}\n")
    exit(2)
}

main() {
    signal(SIGINT, on_interrupt)
    argc = os.args_count()
    cmd = ""
    count = 1
    dry_run = 0
    only = ""
    kind = "auto"
    stray = ""
    i = 1
    while i < argc {
        a = os.args_get(i)
        i = i + 1
        if cmd == "" {
            if a == "--version" {
                println("undiscovered ${version.VERSION}")
                exit(0)
            } else if a == "-h" || a == "--help" {
                print("${USAGE}${HELP}")
                exit(0)
            } else if a == "setup" || a == "work" {
                cmd = a
            } else if string.starts_with(a, "-") == 1 {
                if stray == "" {
                    stray = a
                }
            } else {
                usage_error(USAGE, "undiscovered", "argument cmd: invalid choice: '${a}' (choose from setup, work)")
            }
        } else if cmd == "work" {
            if a == "-h" || a == "--help" {
                print("${WORK_USAGE}${WORK_HELP}")
                exit(0)
            } else if a == "--dry-run" {
                dry_run = 1
            } else if a == "--units" || string.starts_with(a, "--units=") == 1 {
                value = ""
                if a == "--units" {
                    if i >= argc {
                        usage_error(WORK_USAGE, "undiscovered work", "argument --units: expected one argument")
                    }
                    value = os.args_get(i)
                    i = i + 1
                } else {
                    value = string.substring(a, 8, string.length(a))
                }
                n, nerr = string.to_int(string.trim(value))
                if nerr != "" {
                    usage_error(WORK_USAGE, "undiscovered work", "argument --units: invalid int value: '${value}'")
                }
                count = n
            } else if a == "--unit" || string.starts_with(a, "--unit=") == 1 {
                if a == "--unit" {
                    if i >= argc {
                        usage_error(WORK_USAGE, "undiscovered work", "argument --unit: expected one argument")
                    }
                    only = os.args_get(i)
                    i = i + 1
                } else {
                    only = string.substring(a, 7, string.length(a))
                }
            } else if a == "--kind" || string.starts_with(a, "--kind=") == 1 {
                if a == "--kind" {
                    if i >= argc {
                        usage_error(WORK_USAGE, "undiscovered work", "argument --kind: expected one argument")
                    }
                    kind = os.args_get(i)
                    i = i + 1
                } else {
                    kind = string.substring(a, 7, string.length(a))
                }
                if kind != "auto" && kind != "map" && kind != "distill" {
                    usage_error(WORK_USAGE, "undiscovered work", "argument --kind: invalid choice: '${kind}' (choose from auto, map, distill)")
                }
            } else if stray == "" {
                stray = a
            }
        } else {
            if a == "-h" || a == "--help" {
                print("${SETUP_USAGE}${SETUP_HELP}")
                exit(0)
            } else if stray == "" {
                stray = a
            }
        }
    }
    if cmd == "" {
        usage_error(USAGE, "undiscovered", "the following arguments are required: cmd")
    }
    if stray != "" {
        usage_error(USAGE, "undiscovered", "unrecognized arguments: ${stray}")
    }
    code = 0
    if cmd == "setup" {
        code = work.cmd_setup()
    } else {
        code = work.cmd_work(count, dry_run, only, kind)
    }
    exit(code)
}
